# Variables d'environnement — API Express Ressourcerie
# Copier ce fichier en .env et remplir les valeurs

# PostgreSQL local (pgAdmin)
DATABASE_URL=postgresql://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/ressourcerie

# Serveur
PORT=3001
NODE_ENV=development

# JWT — générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=changez_ce_secret_en_production_64_chars_minimum
JWT_EXPIRES_IN=7d

# CORS — adresse du frontend
CORS_ORIGIN=http://localhost:5173

